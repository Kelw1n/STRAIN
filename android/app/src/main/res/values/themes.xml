<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Strain" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Экран запуска: чёрный фон и оранжевый знак, как у REBRN. -->
    <style name="Theme.Strain.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Strain</item>
    </style>
</resources>
