<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Уведомление об окончании отдыха; на Android 13+ спрашивается у пользователя. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Точный будильник на конец отдыха. С Android 13 выдаётся при установке
         и предназначен как раз для таймеров; на Android 12 его ещё нет,
         поэтому там просим второе и умеем обойтись без него. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Сеть для ленты тренировок -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Вибрация при таймере и тапах -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Фото к тренировке снимает системная камера: своего разрешения на камеру
         не нужно, а объявленное, но не выданное, роняло бы её запуск. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".StrainApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Strain">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Strain.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="strain" />
            </intent-filter>
        </activity>

        <!-- Картинка тренировки для «Поделиться»: отдаётся из временной папки без разрешений на память. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Напоминание о тренировке в назначенное время. -->
        <receiver
            android:name=".service.ReminderReceiver"
            android:exported="false" />

        <!-- Кнопки отсчёта отдыха в шторке: −30 с, +30 с, «Пропустить». -->
        <receiver
            android:name=".service.RestActionReceiver"
            android:exported="false" />

        <!-- Срабатывает в момент окончания отдыха, когда приложение свёрнуто. -->
        <receiver
            android:name=".service.RestFinishedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.texasprogram.app.REST_FINISHED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
